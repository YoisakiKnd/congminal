    "tools/fixtures/render_working_set_cases.rs": {
      "sha256": "dd6b3b9ab7bd40bb6cd0799edc74e4889ac60bfbbcb81e6af0d34705d0b08294",
      "source": "#[cfg(test)]\nmod working_set_cost {\n    use super::*;\n    use crate::{resources::{Budget,Scope},vt::Parser};\n    use std::time::Instant;\n    #[test]\n    #[ignore=\"same fixture appended to baseline/current copies by check_render_work.py\"]\n    fn same_pixels_full_and_idle_views() {\n        let outline=std::env::var_os(\"CONGMINAL_RENDER_OUTLINE\").as_deref()==Some(std::ffi::OsStr::new(\"1\"));\n        let pool=Budget::new(256*1024*1024,if outline {1024*1024*1024}else{0});let _scope=Scope::enter(pool.clone());\n        let config=Config::default();let mut renderer=Renderer::new(&config,1.0);\n        if !outline {assert!(renderer.fonts.description.contains(\"Terminus\"));}\n        eprintln!(\"RENDER_FONT {:?}\",renderer.fonts.description);\n        let mut terms=[Terminal::new(160,48),Terminal::new(81,25)];let mut views=[ViewState::default(),ViewState::default()];\n        let mut frames=terms.each_ref().map(|t|{let(w,h)=renderer.pixel_size(t.cols(),t.rows());Framebuffer::new(w as usize,h as usize)});\n        for term in &mut terms {\n            let mut parser=Parser::new();\n            for row in 0..term.rows() {let text=if row%2==0 {\"fn main(){return x!=0;} e\\u{301} x\\u{301}\\u{302} \ud83d\udc68\\u{200D}\ud83d\udc69\\u{200D}\ud83d\udc67 \ud83c\udde8\ud83c\uddf3\"}else{\"\\x1b[1m==> != <= -> \\x1b[0m1\\u{fe0f}\\u{20e3} \u2764\\u{fe0f}\\u{200d}\ud83d\udd25  abcxyz\"};parser.advance(term,format!(\"\\x1b[{};1H{}\",row+1,text).as_bytes());}\n        }\n        for i in 0..16 {let v=i%2;renderer.swap_view(&mut views[v]);renderer.invalidate();renderer.draw(&terms[v],\"\",None,true,&mut frames[v]);renderer.swap_view(&mut views[v]);}\n        // RENDER_METER_START\n        for full in [true,false] {\n            let mode=if full{\"full\"}else{\"idle\"};let mut samples=[0u64;200];eprintln!(\"RENDER_WORK_START mode={mode}\");let total=Instant::now();\n            for (i,ns) in samples.iter_mut().enumerate() {\n                let v=i%2;renderer.swap_view(&mut views[v]);if full{renderer.invalidate();}\n                let started=Instant::now();let damage=renderer.draw(&terms[v],\"\",None,true,&mut frames[v]);*ns=started.elapsed().as_nanos() as u64;\n                if !full {assert!(damage.is_none());}renderer.swap_view(&mut views[v]);\n            }\n            let elapsed=total.elapsed().as_nanos();let pixels=hash(&(&frames[0].pixels,&frames[1].pixels));\n            eprintln!(\"RENDER_WORK_END mode={mode} total_ns={elapsed} pixels={pixels} samples={samples:?}\");\n        }\n        drop((renderer,terms,views,frames));assert_eq!(pool.snapshot().used,0);assert_eq!(pool.snapshot().mappings,0);\n        // RENDER_METER_STOP\n        eprintln!(\"RENDER_WORK_CLEAN final=0\");\n    }\n}\n"
    },
    "tools/fixtures/render_working_allocation_cases.rs": {
      "sha256": "04ad4afd6fbb5e02fcf0fd2e7d6b836a1163c2a815eb15fcabf74ba6dbf28fd2",
      "source": "#[cfg(test)]\nmod working_allocation {\n    use super::*;\n    use crate::{executor_allocation_meter as meter,resources::{Budget,Scope,Kind}};\n    #[test]\n    fn cold_work_growth_overlap_move_denial_and_release_are_funded() {\n        let pool=Budget::new(512*1024,0);let _scope=Scope::enter(pool.clone());\n        let mut work=work::Work::default();let mut view=ViewState::default();let _=pool.snapshot();\n        meter::start();\n        for (rows,cols) in [(8,12),(48,160),(2048,512),(256,4096)] {\n            work.rows.reserve_capacity(rows).unwrap();work.rows.data.resize(rows,0x1234);\n            work.text(cols);assert!(work.ligatures_ready);assert!(work.emoji.capacity()>=crate::term::emoji_work_bytes(cols));\n            std::mem::swap(&mut work.rows,&mut view.rows);\n            let c=meter::peek();let s=pool.snapshot();assert!(c.live>=0&&c.live as usize<=s.kinds[Kind::Render as usize]);assert!(c.peak as usize<=s.peak);\n        }\n        let c=meter::peek();let s=pool.snapshot();let hold=pool.lease(Kind::Queue,s.limit-s.used).unwrap();\n        assert!(work.rows.reserve_capacity(usize::MAX).is_none());assert!(work.word.reserve_capacity(usize::MAX).is_none());assert!(work.emoji.reserve_capacity(work.emoji.capacity()+1024).is_none());\n        let rejected=meter::peek();assert_eq!((c.allocations,c.reallocations),(rejected.allocations,rejected.reallocations));drop(hold);\n        let live=c.live;let peak=c.peak;let used=s.used;let budget_peak=s.peak;\n        work.release();drop(view);assert_eq!(pool.snapshot().kinds[Kind::Render as usize],0);\n        let counts=meter::stop();assert_eq!(counts.live,0);\n        eprintln!(\"RENDER_ALLOC live={live} peak={peak} used={used} budget_peak={budget_peak} final=0 allocations={} reallocations={}\",counts.allocations,counts.reallocations);\n    }\n}\n"
    },
    "tools/fixtures/executor_allocation_meter.rs": {
      "sha256": "4e00543966514b217af7c7e8bbd33fd2df64e9800800e02db59098842f53801b",
      "source": "//! \u4e34\u65f6\u526f\u672c\u4e13\u7528\uff1a\u6309epoch\u6807\u8bb0\u6bcf\u4e2a\u5206\u914d\uff0c\u8de8\u7ebf\u7a0b\u8f6c\u4ea4/\u91ca\u653e\u4e0d\u4f1a\u6f0f\u8ba1\u6216\u51cf\u53bb\u8ba1\u91cf\u524d\u5bf9\u8c61\u3002\nuse std::{alloc::{GlobalAlloc,Layout,System},cell::UnsafeCell,sync::atomic::{AtomicBool,AtomicU64,Ordering}};\n#[derive(Clone,Copy,Default)]\npub struct Counts {pub allocations:usize,pub reallocations:usize,pub live:isize,pub peak:isize}\nstruct Counter {locked:AtomicBool,counts:UnsafeCell<Counts>}\n// \u53ea\u5728locked\u6301\u6709\u671f\u95f4\u8bbf\u95eecounts\uff1b\u9501\u5185\u4e0d\u8c03\u7528\u5206\u914d\u3001\u683c\u5f0f\u5316\u6216\u7528\u6237\u4ee3\u7801\u3002\nunsafe impl Sync for Counter {}\nstatic COUNTER:Counter=Counter{locked:AtomicBool::new(false),counts:UnsafeCell::new(Counts{allocations:0,reallocations:0,live:0,peak:0})};\nstatic EPOCH:AtomicU64=AtomicU64::new(0);\nstatic ACTIVE:AtomicBool=AtomicBool::new(false);\nfn locked<T>(f:impl FnOnce(&mut Counts)->T)->T {\n    while COUNTER.locked.compare_exchange_weak(false,true,Ordering::Acquire,Ordering::Relaxed).is_err(){std::hint::spin_loop();}\n    let result=f(unsafe{&mut *COUNTER.counts.get()});COUNTER.locked.store(false,Ordering::Release);result\n}\npub fn start(){assert!(!ACTIVE.load(Ordering::SeqCst));EPOCH.fetch_add(1,Ordering::SeqCst);locked(|counts|*counts=Counts::default());ACTIVE.store(true,Ordering::SeqCst);}\npub fn peek()->Counts {locked(|counts|*counts)}\npub fn stop()->Counts {ACTIVE.store(false,Ordering::SeqCst);peek()}\nfn tag()->u64 {if ACTIVE.load(Ordering::SeqCst){EPOCH.load(Ordering::SeqCst)}else{0}}\nfn record(new:usize,new_epoch:u64,old:usize,old_epoch:u64,realloc:bool) {\n    let current=EPOCH.load(Ordering::SeqCst);let add=new_epoch!=0 && new_epoch==current;let remove=old_epoch!=0 && old_epoch==current;\n    if !add && !remove{return;}\n    locked(|counts|{if add{counts.allocations+=1;counts.reallocations+=usize::from(realloc);counts.live+=new as isize;counts.peak=counts.peak.max(counts.live);}if remove{counts.live-=old as isize;}});\n}\nfn expanded(layout:Layout)->(Layout,usize) {\n    let align=layout.align().max(std::mem::align_of::<u64>());let offset=std::mem::size_of::<u64>().div_ceil(align)*align;\n    (Layout::from_size_align(layout.size().checked_add(offset).unwrap(),align).unwrap(),offset)\n}\npub struct Meter;\n#[global_allocator]\nstatic GLOBAL:Meter=Meter;\n// \u5f53\u524d1.99\u4f18\u5316\u6784\u5efa\u4e2d\uff0c\u5185\u8054\u6b64\u5e26\u5934\u8ba1\u91cf\u5668\u4f1a\u6539\u53d8\u4e34\u65f6String\u5339\u914d\uff1b\u4fdd\u6301\u5206\u914d\u5165\u53e3\u8fb9\u754c\uff0c\u53e6\u8dd1\u539f\u5feb\u6377\u952e\u56de\u5f52\u3002\n// \u4ec5\u4e34\u65f6\u8ba1\u91cf\u526f\u672c\u4f7f\u7528\uff1b\u4e0d\u4fee\u6539\u751f\u4ea7System\u5206\u914d\u5668\uff0c\u4e5f\u4e0d\u7528\u5b83\u6d4b\u5ef6\u8fdf\u3002\nunsafe impl GlobalAlloc for Meter {\n    #[inline(never)]\n    unsafe fn alloc(&self,layout:Layout)->*mut u8 {\n        let (expanded,offset)=expanded(layout);let base=unsafe{System.alloc(expanded)};if base.is_null(){return base;}\n        let epoch=tag();unsafe{base.cast::<u64>().write(epoch);}record(layout.size(),epoch,0,0,false);unsafe{base.add(offset)}\n    }\n    #[inline(never)]\n    unsafe fn alloc_zeroed(&self,layout:Layout)->*mut u8 {\n        let (expanded,offset)=expanded(layout);let base=unsafe{System.alloc_zeroed(expanded)};if base.is_null(){return base;}\n        let epoch=tag();unsafe{base.cast::<u64>().write(epoch);}record(layout.size(),epoch,0,0,false);unsafe{base.add(offset)}\n    }\n    #[inline(never)]\n    unsafe fn dealloc(&self,pointer:*mut u8,layout:Layout) {\n        let (expanded,offset)=expanded(layout);let base=unsafe{pointer.sub(offset)};let epoch=unsafe{base.cast::<u64>().read()};\n        record(0,0,layout.size(),epoch,false);unsafe{System.dealloc(base,expanded);}\n    }\n    #[inline(never)]\n    unsafe fn realloc(&self,pointer:*mut u8,layout:Layout,length:usize)->*mut u8 {\n        let (expanded,offset)=expanded(layout);let base=unsafe{pointer.sub(offset)};let old_epoch=unsafe{base.cast::<u64>().read()};\n        let Some(size)=length.checked_add(offset)else{return std::ptr::null_mut();};let base=unsafe{System.realloc(base,expanded,size)};if base.is_null(){return base;}\n        let epoch=tag();unsafe{base.cast::<u64>().write(epoch);}record(length,epoch,layout.size(),old_epoch,true);unsafe{base.add(offset)}\n    }\n}\n"
    }
